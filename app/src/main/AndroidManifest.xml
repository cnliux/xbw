<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络：所有游戏数据均实时抓取，无内置数据 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 自动升级：下载 APK 后拉起系统安装器（用户需在系统里授权"安装未知应用"） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- U盘本地游戏：扫描挂载卷里的 ROM 文件。Android 6~9 需要运行时读写权限
         （WRITE 在老系统上同时覆盖读）；10+ 走 StorageVolume，读不到时分类自带排查提示 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- Android 11+ 包可见性：自更新要能查到系统安装器与浏览器 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- 手柄：声明为「可选」，保证手机/盒子也能安装调试；遥控器同样可用 -->
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />
    <!-- TV 设备特性：非触屏设备 -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- 游戏需要 USB 手柄（热插拔） -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:name=".XbwApplication"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:largeHeap="true"
        android:theme="@style/Theme.XbwTv"
        tools:targetApi="34">

        <!-- 大厅（TV 启动入口：category=leanback.launcher） -->
        <activity
            android:name=".ui.lobby.LobbyActivity"
            android:banner="@drawable/tv_banner"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.XbwTv.Lobby">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- TV 桌面入口 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- 兼容手机/平板桌面，方便用真机调试 -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 游戏页：libretro 原生核心（FC=FCEUmm，街机=FBNeo） -->
        <activity
            android:name=".ui.game.NativeGameActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|uiMode|density|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.XbwTv.Game" />

        <!-- 视频类游戏页：插件源里只有 <video> 的条目 -->
        <activity
            android:name=".ui.game.VideoGameActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.XbwTv.Game" />

        <!-- 搜索页 -->
        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.XbwTv.Lobby"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- 设置页（手柄状态 / 按键映射 / 缓存） -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.XbwTv.Lobby" />

        <!-- 按键映射编辑器 -->
        <activity
            android:name=".ui.settings.KeyMappingActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.XbwTv.Lobby" />

        <!-- 调试页：展示站点结构诊断结果（选择器失配时第一时间看这里） -->
        <activity
            android:name=".ui.plugin.PluginsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.XbwTv.Lobby" />
        <activity
            android:name=".ui.plugin.PluginEditActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.XbwTv.Lobby"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.diagnose.DiagnoseActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.XbwTv.Lobby" />
    <!-- 自更新：把 cacheDir/updates 下的 APK 以 content:// 交给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
