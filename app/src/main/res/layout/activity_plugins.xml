<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xbw_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/plugins_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/plugins_hint"
            android:textColor="@color/xbw_text_secondary"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_plugins"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_add_plugin"
            style="@style/SettingItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/xbw_surface"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/plugins_add"
            android:textColor="@color/xbw_accent"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>