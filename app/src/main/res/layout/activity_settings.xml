<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页：全部原生行，方向键逐行聚焦，A 键触发（方案第九步打磨项）。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lobby"
    android:clipToPadding="false"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="48dp"
        android:paddingTop="24dp"
        android:paddingRight="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/settings_title"
            android:textColor="@color/xbw_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- ① 手柄状态 -->
        <LinearLayout
            android:id="@+id/row_gamepad"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_gamepad"
                android:textColor="@color/xbw_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/val_gamepad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/xbw_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ② 菜单呼出键 -->
        <LinearLayout
            android:id="@+id/row_hotkey"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_menu_key"
                android:textColor="@color/xbw_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/val_hotkey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/xbw_success"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ③ 按键映射 -->
        <LinearLayout
            android:id="@+id/row_mapping"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_mapping"
                android:textColor="@color/xbw_text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/xbw_text_disabled"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- ⑥ 站点诊断 -->
        <LinearLayout
            android:id="@+id/row_diagnose"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_diagnose"
                android:textColor="@color/xbw_text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/xbw_text_disabled"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- ⑦ 拼音索引 -->
        <LinearLayout
            android:id="@+id/row_pinyin"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_pinyin_index"
                android:textColor="@color/xbw_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/val_pinyin_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/xbw_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ⑧ 清除列表缓存 -->
        <LinearLayout
            android:id="@+id/row_clear_cache"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_clear_cache"
                android:textColor="@color/xbw_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/val_cache_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/xbw_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ⑧ 清除最近玩过 -->
        <LinearLayout
            android:id="@+id/row_clear_recent"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_clear_recent"
                android:textColor="@color/xbw_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/val_recent_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/xbw_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ⑨ 恢复默认映射 -->
        <!-- 第三方游戏源（插件） -->
        <LinearLayout
            android:id="@+id/row_plugins"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_plugins"
                android:textColor="@color/xbw_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/val_plugins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/xbw_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_reset_map"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_reset_map"
                android:textColor="@color/xbw_text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ⑩ 自动升级开关 -->
        <LinearLayout
            android:id="@+id/row_auto_update"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_auto_update"
                android:textColor="@color/xbw_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/val_auto_update"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/xbw_text_disabled"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ⑪ 立即检查更新 -->
        <LinearLayout
            android:id="@+id/row_check_update"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_check_update"
                android:textColor="@color/xbw_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/val_current_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/xbw_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ⑫ 关于 -->
        <LinearLayout
            android:id="@+id/row_about"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_about"
                android:textColor="@color/xbw_text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/xbw_text_disabled"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hotkey_capture_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_hint_bar"
            android:padding="12dp"
            android:textColor="@color/xbw_warning"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
